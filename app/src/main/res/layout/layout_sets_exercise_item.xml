<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/number_sets_tv"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="1"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/slate_secondary"
        app:backgroundTint="@color/blue_primary_container"
        app:cornerRadius="8dp"
        app:icon="@drawable/exercise_24dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/weight_number_bt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/weight_number_bt" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/weight_number_bt"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="0 Kg"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/slate_secondary"
        app:icon="@drawable/weight_24dp"
        app:iconGravity="textStart"
        app:layout_constraintStart_toEndOf="@+id/number_sets_tv"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reps_number_bt"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="0 Reps"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/slate_secondary"
        app:icon="@drawable/repeat_24dp"
        app:iconGravity="textStart"
        app:layout_constraintStart_toEndOf="@+id/weight_number_bt"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/edit_set_exercise"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Editar"
        app:cornerRadius="12dp"
        app:icon="@drawable/border_color_24dp"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/weight_number_bt" />

</androidx.constraintlayout.widget.ConstraintLayout>