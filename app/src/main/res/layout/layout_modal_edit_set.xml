<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/close_dialog_bt"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/close_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/num_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_dialog_bt">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weight_plus_bt"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/add_24dp" />

        <EditText
            android:id="@+id/weight_et"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="0 kg"
            android:inputType="numberDecimal"
            android:padding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weight_less_bt"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/remove_24dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/num_rep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/num_weight">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rep_plus_bt"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/add_24dp" />

        <EditText
            android:id="@+id/height_et"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="0 reps"
            android:inputType="numberDecimal"
            android:padding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rep_less_bt"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/remove_24dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>